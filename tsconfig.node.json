{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "types": [
            "node"
        ],
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "emitDeclarationOnly": false,
        "outDir": "./node_modules/.tmp"
    },
    "include": [
        "vite.config.ts"
    ]
}